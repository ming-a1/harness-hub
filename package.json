{
  "name": "@local/harness-hub",
  "version": "2.0.5",
  "private": true,
  "type": "module",
  "description": "Plugin Hub for DeepSeek Harness: one sidebar entry whose tabs are the panels other installed plugins contribute, loaded dynamically and never copied.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "bundle",
    "hub",
    "tabs"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
