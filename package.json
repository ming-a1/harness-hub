{
  "name": "@local/harness-hub",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Plugin Hub for DeepSeek Harness: one sidebar entry whose tabs carry session cleanup, the skill gallery, the token vault and every other plugin panel collected from the sidebar.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "bundle",
    "skills",
    "session-cleanup",
    "token-vault"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "host/*.js",
    "lib/*.js",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
